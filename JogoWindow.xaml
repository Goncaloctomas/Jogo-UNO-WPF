<Window x:Class="Jogo.JogoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="UNO" Height="750" Width="1050"
        WindowStartupLocation="CenterScreen"
        Closing="Window_Closing">

    <Window.Resources>

        <!-- Carta do jogador humano -->
        <Style x:Key="CartaHumanoStyle" TargetType="Button">
            <Setter Property="Width"           Value="90"/>
            <Setter Property="Height"          Value="126"/>
            <Setter Property="Margin"          Value="5,0"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="Padding"         Value="0"/>
            <Style.Triggers>
                <MultiTrigger>
                    <MultiTrigger.Conditions>
                        <Condition Property="IsMouseOver" Value="True"/>
                        <Condition Property="IsEnabled"   Value="True"/>
                    </MultiTrigger.Conditions>
                    <MultiTrigger.Setters>
                        <Setter Property="RenderTransform">
                            <Setter.Value><TranslateTransform Y="-14"/></Setter.Value>
                        </Setter>
                        <Setter Property="Panel.ZIndex" Value="10"/>
                    </MultiTrigger.Setters>
                </MultiTrigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.45"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Botão de ação genérico -->
        <Style x:Key="BtnAcaoStyle" TargetType="Button">
            <Setter Property="Foreground"      Value="White"/>
            <Setter Property="FontWeight"      Value="Bold"/>
            <Setter Property="FontSize"        Value="13"/>
            <Setter Property="Padding"         Value="14,7"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" CornerRadius="6"
                                Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.8"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Botão circular de cor (escolha após Joker) -->
        <Style x:Key="BtnCorStyle" TargetType="Button">
            <Setter Property="Width"           Value="50"/>
            <Setter Property="Height"          Value="50"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding"         Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" CornerRadius="25"
                                Background="{TemplateBinding Background}"
                                BorderThickness="3" BorderBrush="White">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="#ffe066"/>
                                <Setter TargetName="bd" Property="BorderThickness" Value="4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Grid>
        <!-- Fundo -->
        <Image Source="/Assets/background_game.jpeg"
               Stretch="UniformToFill"/>
        <Rectangle Fill="#55000000"/>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="44"/>    <!-- barra topo -->
                <RowDefinition Height="*"/>     <!-- área jogo -->
                <RowDefinition Height="175"/>   <!-- mão humano -->
            </Grid.RowDefinitions>

            <!-- ══════════════════════════════════════════
                 LINHA 0 — Barra: Pausa | Ajuda | Estado
                 ══════════════════════════════════════════ -->
            <Grid Grid.Row="0" Background="#DD000000">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Content="Pausa"
                        Style="{StaticResource BtnAcaoStyle}"
                        Background="Transparent"
                        FontSize="15" Margin="12,0,0,0"
                        Click="BtnPausa_Click"/>

                <Button Grid.Column="1" Content="Ajuda"
                        Style="{StaticResource BtnAcaoStyle}"
                        Background="Transparent"
                        FontSize="15" Margin="4,0"
                        Click="BtnAjuda_Click"/>

                <TextBlock Grid.Column="2"
                           x:Name="TxtEstado"
                           Text=""
                           Foreground="White" FontWeight="Bold" FontSize="14"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>

                <Button Grid.Column="3" Content="Sair"
                        Style="{StaticResource BtnAcaoStyle}"
                        Background="#8B0000"
                        FontSize="13" Margin="0,0,12,0"
                        Click="BtnSair_Click"/>
            </Grid>

            <!-- ══════════════════════════════════════════
                 LINHA 1 — Área de jogo
                 Estrutura interna:
                   Linha 0 topo : Bot 1 (centro)
                   Linha 1 meio : Bot 2 (esq) | Mesa | Bot 3 (dir)
                 ══════════════════════════════════════════ -->
            <Grid Grid.Row="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>  <!-- Bot 1 topo -->
                    <RowDefinition Height="*"/>     <!-- jogo centro -->
                </Grid.RowDefinitions>

                <!-- ── Bot 1 — TOPO CENTRO ── -->
                <Border Grid.Row="0"
                        x:Name="BorderBot1"
                        CornerRadius="10" Padding="10,8"
                        Background="#AA000000"
                        BorderThickness="3" BorderBrush="Transparent"
                        HorizontalAlignment="Center"
                        Margin="0,8,0,0">
                    <StackPanel>
                        <TextBlock x:Name="NomeBot1" Text="Bot 1"
                                   Foreground="White" FontSize="14" FontWeight="Bold"
                                   HorizontalAlignment="Center" Margin="0,0,0,6"/>
                        <Canvas x:Name="CartasBot1Canvas" Height="65" Width="160"
                                HorizontalAlignment="Center"/>
                        <TextBlock x:Name="ContadorBot1" Text="7 Cartas"
                                   Foreground="#bbbbbb" FontSize="12"
                                   HorizontalAlignment="Center" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <!-- ── Linha do meio: Bot2 | Mesa | Bot3 ── -->
                <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="175"/>   <!-- bot esquerda -->
                    <ColumnDefinition Width="*"/>     <!-- mesa central -->
                    <ColumnDefinition Width="175"/>   <!-- bot direita -->
                </Grid.ColumnDefinitions>

                <!-- ── Bot 2 — ESQUERDA (só com ≥2 bots) ── -->
                <Border Grid.Column="0"
                        x:Name="BorderBot2"
                        CornerRadius="10" Padding="10,8"
                        Background="#AA000000"
                        BorderThickness="3" BorderBrush="Transparent"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center"
                        Margin="8,0"
                        Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock x:Name="NomeBot2" Text="Bot 2"
                                   Foreground="White" FontSize="14" FontWeight="Bold"
                                   HorizontalAlignment="Center" Margin="0,0,0,6"/>
                        <Canvas x:Name="CartasBot2Canvas" Height="75" Width="130"
                                HorizontalAlignment="Center"/>
                        <TextBlock x:Name="ContadorBot2" Text="7 Cartas"
                                   Foreground="#bbbbbb" FontSize="12"
                                   HorizontalAlignment="Center" Margin="0,5,0,0"/>
                    </StackPanel>
                </Border>

                <!-- ── MESA CENTRAL ── -->
                <Grid Grid.Column="1" VerticalAlignment="Center">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>   <!-- seta sentido -->
                        <RowDefinition Height="Auto"/>   <!-- baralho + topo -->
                        <RowDefinition Height="Auto"/>   <!-- cor ativa + ações -->
                    </Grid.RowDefinitions>

                    <!-- Seta de sentido de jogo -->
                    <TextBlock Grid.Row="0"
                               x:Name="TxtSentido"
                               Text="↻" FontSize="56"
                               Foreground="White" Opacity="0.55"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,10"/>

                    <!-- Baralho + Carta do topo -->
                    <StackPanel Grid.Row="1"
                                Orientation="Horizontal"
                                HorizontalAlignment="Center">

                        <!-- Baralho de compra -->
                        <StackPanel Margin="0,0,22,0">
                            <Button x:Name="BtnComprar"
                                    Width="90" Height="126"
                                    Cursor="Hand" BorderThickness="0"
                                    Background="Transparent" Padding="0"
                                    Click="BtnComprar_Click"
                                    ToolTip="Clica para comprar uma carta">
                                <Image Source="/Assets/card_back.png"
                                       Width="90" Height="126"
                                       RenderOptions.BitmapScalingMode="HighQuality"/>
                            </Button>
                            <TextBlock x:Name="TxtNumBaralho" Text="108"
                                       Foreground="White" FontSize="12"
                                       HorizontalAlignment="Center" Margin="0,4,0,0"/>
                        </StackPanel>

                        <!-- Carta do topo -->
                        <Border CornerRadius="10"
                                BorderBrush="#ffffff44" BorderThickness="2"
                                Width="90" Height="126">
                            <Image x:Name="ImgCartaTopo"
                                   RenderOptions.BitmapScalingMode="HighQuality"
                                   Stretch="Uniform"/>
                        </Border>
                    </StackPanel>

                    <!-- Linha de ações: cor ativa | comprar | escolha cor -->
                    <StackPanel Grid.Row="2"
                                Orientation="Horizontal"
                                HorizontalAlignment="Center"
                                Margin="0,14,0,0">

                        <!-- Bolinha indicadora de cor ativa -->
                        <Border x:Name="BorderCorAtiva"
                                Width="20" Height="20" CornerRadius="10"
                                Background="Gray" VerticalAlignment="Center"
                                Margin="0,0,6,0"/>
                        <TextBlock x:Name="TxtCorAtiva"
                                   Text="—" Foreground="White" FontSize="13"
                                   VerticalAlignment="Center" Margin="0,0,18,0"/>

                        <!-- Botão comprar carta (ação do humano) -->
                        <Button x:Name="BtnComprarAcao"
                                Content="Comprar Carta"
                                Style="{StaticResource BtnAcaoStyle}"
                                Background="#c0392b"
                                Click="BtnComprar_Click"/>

                        <!-- Botão UNO — aparece quando humano tem 2 cartas -->
                        <Button x:Name="BtnUno"
                                Content="🃏 UNO!"
                                Style="{StaticResource BtnAcaoStyle}"
                                Background="#e67e22"
                                FontSize="15"
                                Margin="10,0,0,0"
                                Visibility="Collapsed"
                                Click="BtnUno_Click"/>

                        <!-- Painel escolha de cor após Joker -->
                        <StackPanel x:Name="PainelEscolhaCor"
                                    Orientation="Horizontal"
                                    Visibility="Collapsed"
                                    Margin="16,0,0,0">
                            <TextBlock Text="Escolhe a cor:"
                                       Foreground="White" FontWeight="Bold"
                                       VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <Button Style="{StaticResource BtnCorStyle}"
                                    Background="#c0392b" Margin="4,0"
                                    Click="BtnCorVermelho_Click"/>
                            <Button Style="{StaticResource BtnCorStyle}"
                                    Background="#27ae60" Margin="4,0"
                                    Click="BtnCorVerde_Click"/>
                            <Button Style="{StaticResource BtnCorStyle}"
                                    Background="#2980b9" Margin="4,0"
                                    Click="BtnCorAzul_Click"/>
                            <Button Style="{StaticResource BtnCorStyle}"
                                    Background="#f1c40f" Margin="4,0"
                                    Click="BtnCorAmarelo_Click"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <!-- ── Bot DIREITA (Bot 3 — só com 3 bots) ── -->
                <Border Grid.Column="2"
                        x:Name="BorderBot3"
                        CornerRadius="10" Padding="10,8"
                        Background="#AA000000"
                        BorderThickness="3" BorderBrush="Transparent"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center"
                        Margin="8,0"
                        Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock x:Name="NomeBot3" Text="Bot 3"
                                   Foreground="White" FontSize="14" FontWeight="Bold"
                                   HorizontalAlignment="Center" Margin="0,0,0,6"/>
                        <Canvas x:Name="CartasBot3Canvas" Height="75" Width="130"
                                HorizontalAlignment="Center"/>
                        <TextBlock x:Name="ContadorBot3" Text="7 Cartas"
                                   Foreground="#bbbbbb" FontSize="12"
                                   HorizontalAlignment="Center" Margin="0,5,0,0"/>
                    </StackPanel>
                </Border>

                </Grid><!-- /Grid linha meio (Bot2+Mesa+Bot3) -->
            </Grid><!-- /Grid linha 1 (Bot1 topo + linha meio) -->

            <!-- ══════════════════════════════════════════
                 LINHA 2 — Mão do jogador humano
                 ══════════════════════════════════════════ -->
            <Grid Grid.Row="2" Background="#CC000000">

                <TextBlock x:Name="NomeJogadorHumano"
                           Text="A tua mão"
                           Foreground="#aaaacc" FontSize="12"
                           HorizontalAlignment="Left" VerticalAlignment="Top"
                           Margin="14,5,0,0"/>

                <ScrollViewer HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Disabled"
                              VerticalAlignment="Bottom"
                              Margin="0,0,0,0"
                              Padding="0,20,0,0">
                    <ItemsControl x:Name="CartasJogador">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Bottom"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource CartaHumanoStyle}"
                                        IsEnabled="{Binding Jogavel}"
                                        Tag="{Binding Carta}"
                                        Click="CartaJogador_Click">
                                    <Image Source="{Binding ImagemPath}"
                                           Width="88" Height="123"
                                           RenderOptions.BitmapScalingMode="HighQuality"
                                           Stretch="Uniform"/>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>

        </Grid>
    </Grid>
</Window>
